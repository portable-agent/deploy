{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "autoSync", "replicas"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "autoSync": {"type": "boolean"},
          "replicas": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

